generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model ForumReminder {
  id            Int      @id @default(autoincrement())
  userId        Int
  discussionId  Int
  forumId       Int
  notified      Boolean  @default(false)
  replied       Boolean  @default(false)
  lastChecked   DateTime @default(now())

  @@unique([userId, discussionId])
}
