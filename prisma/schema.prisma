generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserPushToken {
  id        Int    @id @default(autoincrement())
  userId    Int    @unique
  pushToken String
  platform  String
}

model ForumReplyStatus {
  id            Int       @id @default(autoincrement())
  userId        Int
  courseId      Int
  forumId       Int
  discussionId  Int

  replied       Boolean   @default(false)
  repliedAt     DateTime?

  notified      Boolean   @default(false)
  notifiedAt    DateTime?

  @@unique([userId, discussionId])
}